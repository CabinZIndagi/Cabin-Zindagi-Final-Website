# EmailJS credentials (https://www.emailjs.com)
# 1. Create a free account and an email service + template.
# 2. Copy the IDs/key below, then rename this file to ".env.local".
# 3. Restart the dev server after changing these.
#
# Your EmailJS template should include the variables:
#   {{from_name}}, {{from_email}}, {{company}}, {{message}}

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Supabase — stores driver leads from the /for-drivers gate.
# 1. Create a project at https://supabase.com, then run supabase/driver_leads.sql
#    in the SQL editor to create the table.
# 2. Project Settings → API: copy the Project URL and the service_role key.
# 3. These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) — the service_role key must
#    never reach the browser. .env.local is gitignored; keep it that way.
# 4. View or export the leads any time: Table Editor → driver_leads → Export CSV.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── SEO ────────────────────────────────────────────────────────────────────
# OPTIONAL. Production needs nothing here — lib/site.ts already defaults to the
# live origin (https://cabinzindagi.com), which is what sitemap.xml, robots.txt,
# llms.txt, canonicals and OG tags are built from.
# Only set this to point a non-production build at a different origin, e.g. a
# staging domain. Protocol required, no trailing slash.
# NEXT_PUBLIC_SITE_URL=https://staging.cabinzindagi.com

# ─── Bhashini (Indian language translation) ─────────────────────────────────
# Powers `npm run translate`, which fills lib/i18n/generated/ with the 22
# Eighth Schedule languages. BUILD-TIME ONLY — no visitor request ever reaches
# Bhashini, so these are server-side and must never get a NEXT_PUBLIC_ prefix.
# 1. Register as an integrator at https://bhashini.gov.in (organization =
#    Cabin Zindagi; you will need an org ID document under 5MB).
# 2. From the ULCA dashboard, copy your User ID and API key below.
# 3. Run `npm run translate`, then review the output before shipping.
# Note: the free tier is for proof-of-concept use — ask Bhashini for a paid
# plan before relying on it for production copy.

BHASHINI_USER_ID=your_ulca_user_id
BHASHINI_API_KEY=your_ulca_api_key

# ─── HuggingFace (IndicTrans2 backend) ──────────────────────────────────────
# Powers `npm run translate:indictrans2`. The IndicTrans2 models are MIT-licensed
# but AI4Bharat GATES the HuggingFace repos, so a download needs an account:
# 1. Sign in at https://huggingface.co and accept the terms on the model page:
#    https://huggingface.co/ai4bharat/indictrans2-en-indic-1B
#    (and .../indictrans2-en-indic-dist-200M if you use --model dist)
# 2. Create a READ token: https://huggingface.co/settings/tokens
# 3. Paste it below. BUILD-TIME ONLY — never reaches the browser.

HF_TOKEN=hf_your_read_token
